# 安全响应头（全站）
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self'; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests

# 音频：内容永久不变，长缓存
/zhixiao/chapters/*
  Cache-Control: public, max-age=31536000, immutable
/nanian/chapters/*
  Cache-Control: public, max-age=31536000, immutable

# 章节数据与播放器脚本：短缓存
/zhixiao/data.json
  Cache-Control: public, max-age=300, must-revalidate
/nanian/data.json
  Cache-Control: public, max-age=300, must-revalidate
/nanian/chapters.js
  Cache-Control: public, max-age=300, must-revalidate

# Service Worker：确保正确的 Content-Type 和不缓存
/zhixiao/sw.js
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: application/javascript
/nanian/sw.js
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: application/javascript

# 静态图片：长缓存
/og-cover.png
  Cache-Control: public, max-age=604800
